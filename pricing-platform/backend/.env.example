# --- App ---
APP_ENV=development
APP_NAME=Retail Pricing Intelligence Platform
API_V1_PREFIX=/api/v1
DEBUG=true

# --- Security ---
JWT_SECRET_KEY=change-me-in-secrets-manager
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
REMEMBER_ME_REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Database (MySQL 8) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=rpip_db
MYSQL_USER=rpip_user
MYSQL_PASSWORD=rpip_password

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0

# --- CORS ---
CORS_ORIGINS=http://localhost:5173

# --- AWS (placeholders only — real values come from AWS Secrets Manager in prod) ---
AWS_REGION=us-east-1
# Leave blank for local dev: bulk-import files then fall back to
# LOCAL_STORAGE_DIR on disk instead of S3 — see app/storage/__init__.py.
S3_BUCKET_NAME=

# --- Bulk import (Phase 5) ---
LOCAL_STORAGE_DIR=var/storage
MAX_IMPORT_FILE_SIZE_MB=20

# --- Output orchestration (Phase 7) ---
# Frontend base URL — used to build the public price-display link QR/Web outputs point to.
PUBLIC_BASE_URL=http://localhost:5173

# --- ESL device platform (Phase 8) ---
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC_PREFIX=retail

# --- Third-party ESL integrations (Phase 9) ---
# Fernet key encrypting esl_integrations.configuration_encrypted at rest.
# Insecure dev-only default, same pattern as JWT_SECRET_KEY — override via
# AWS Secrets Manager in production. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ESL_CREDENTIALS_ENCRYPTION_KEY=GiGeYdXUIRHcfnliSeP1fCccJiVwUqFj8d8ZolXnd_E=
